{
  "name": "sequelnet-schema-generator",
  "displayName": "SequelNet Schema Generator",
  "description": "Generates or updates SequelNet DAL code from a macro comment or selection.",
  "version": "3.0.160",
  "publisher": "danielgindi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielgindi/SequelNet.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sequelnet.generateOrUpdateDal",
        "title": "SequelNet: Generate or Update DAL from Macro"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sequelnet.generateOrUpdateDal",
          "when": "editorLangId == csharp",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "SequelNet Schema Generator",
      "properties": {
        "sequelnet.generatorCommand": {
          "type": "string",
          "default": "",
          "description": "Optional executable that overrides the bundled SequelNet schema generator CLI. The bundled CLI uses the .NET 8 runtime."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm run compile",
    "package": "node scripts/package.js",
    "test": "esbuild src/macro.ts src/generatedRegion.ts --bundle --platform=node --format=cjs --outdir=.tmp && node test/macro.test.js && node test/generatedRegion.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}